# Apache agrega la barra final sola cuando la URL es una carpeta (DirectorySlash);
# eso pelea con la regla de abajo que la sacaba y quedaba en loop infinito.
DirectorySlash Off

RewriteEngine On
RewriteBase /

# /ruta/ (con barra, carpeta existente) -> /ruta (sin barra), asi queda como
# los links internos del sitio. Con DirectorySlash apagado no vuelve a entrar
# en loop: esta regla corre una sola vez y de ahi la sirve la de abajo.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !^/$
RewriteCond %{REQUEST_URI} ^(.+)/$
RewriteRule ^ %1 [R=301,L]

# /ruta (sin barra, carpeta existente) -> sirve /ruta/index.html sin cambiar
# la URL del navegador.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*[^/])$ $1/index.html [L]

ErrorDocument 404 /404/index.html
