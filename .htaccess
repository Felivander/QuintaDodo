# Apache agrega la barra final sola cuando la URL es una carpeta (DirectorySlash);
# eso pelea con la regla de abajo que la sacaba y quedaba en loop infinito.
DirectorySlash Off

RewriteEngine On
RewriteBase /

# /ruta/ (con barra, carpeta existente) -> /ruta (sin barra), asi queda como
# los links internos del sitio. Con DirectorySlash apagado no vuelve a entrar
# en loop: esta regla corre una sola vez y de ahi la sirve la de abajo.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !^/$
RewriteCond %{REQUEST_URI} ^(.+)/$
RewriteRule ^ %1 [R=301,L]

# /ruta (sin barra, carpeta existente) -> sirve /ruta/index.html sin cambiar
# la URL del navegador.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*[^/])$ $1/index.html [L]

ErrorDocument 404 /404/index.html

# ---- cache ----
# El servidor manda max-age=7 dias por defecto. El HTML, y sobre todo nuestro
# CSS/JS (assets/quintadodo, ver el .htaccess de esa carpeta), cambian con cada
# deploy: si el navegador guarda un css viejo con un js nuevo, la pagina se ve
# rota. Se revalidan siempre (304 si no cambiaron). Las fotos se guardan 1 hora
# para que un reemplazo de foto (mismo nombre de archivo) llegue rapido.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/jpeg "access plus 1 hour"
  ExpiresByType image/png "access plus 1 hour"
  ExpiresByType image/webp "access plus 1 hour"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
